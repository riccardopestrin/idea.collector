# Supabase — valori dal progetto (Dashboard → Settings → API).
# Copiare in .env.local (non committato) con i valori veri.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Valutazione AI (RFC-003 / ADR-0003) — API key Anthropic, solo lato server.
ANTHROPIC_API_KEY=sk-ant-your-key

# GitHub App per il contesto repo (ADR-0004). App ID, slug (l'URL pubblico
# dell'App è github.com/apps/<slug>) e private key PEM: incollarla su una riga
# sostituendo gli a-capo con \n. Solo lato server, mai nel DB.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Demo senza crediti API: 1 = salta Claude e persiste punteggi fittizi (stub).
# Rimuovere/0 quando ANTHROPIC_API_KEY è operativa.
AI_EVAL_FAKE=0

# Come AI_EVAL_FAKE ma per lo scan anti-duplicato/competitor (RFC-006):
# 1 = salta Claude e persiste un report fittizio senza match.
AI_SCAN_FAKE=0

# Service role (Dashboard → Settings → API; in locale: `pnpm exec supabase status`).
# SOLO lato server: inviti/rimozione utenti e scrittura esiti scan/eval
# (SEC-9, migration 0020). Mai esporla al client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
